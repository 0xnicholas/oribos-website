---
// The shared final CTA (SPEC §3.8): the home page, the use-case pages and the keyword pages all
// render this one component with the same copy and structure. `coming soon` here is publishing
// switch point #3 — a passive badge, never a link; the repository link is the action.
import { LINKS } from '../lib/links.ts';
import Star from './icons/Star.astro';

export interface Props {
	heading: string;
	sub: string;
}

const { heading, sub } = Astro.props;
---
<section id="get-started" class="border-t border-line px-6 py-24">
	<div class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
		<h2 class="text-3xl font-semibold tracking-tight text-ink">{heading}</h2>
		<p class="max-w-xl text-ink2">{sub}</p>
		<div class="flex flex-wrap items-center justify-center gap-3">
			<a href={LINKS.github} class="btn btn-primary"><Star />GitHub</a>
			<span class="bg-acc-lo px-3 py-1 text-xs font-semibold text-acc-h">coming soon</span>
		</div>
	</div>
</section>
