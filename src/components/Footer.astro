---
// The one footer every page carries (SPEC §2.3): brand block → four columns → legal row.
// No newsletter slot, no social column, no status line; the external targets are the links
// constants, so the docs switch point stays one edit. The tagline comes from `src/lib/brand.ts`,
// split at its sentence boundary for the two-line brand-block typography.
import { publicTagline } from '../lib/brand.ts';
import { footerColumns } from '../lib/navigation.ts';

const [taglineLead, ...taglineRest] = publicTagline.split('. ');
---
<footer class="mt-24 border-t border-line">
	<div class="wrap grid gap-10 py-12 md:grid-cols-[minmax(0,1.4fr)_repeat(4,minmax(0,1fr))]">
		<div class="max-w-xs">
			<a href="/" class="text-lg font-semibold tracking-tight text-ink">Oribos</a>
			<p class="mt-3 text-base text-ink2">
				<span class="font-semibold">{taglineLead}.</span><br />
				{taglineRest.join('. ')}
			</p>
		</div>
		{footerColumns.map((column) => (
			<nav aria-label={column.heading}>
				<h2 class="text-base font-semibold text-ink">{column.heading}</h2>
				<ul class="mt-3 flex flex-col gap-2">
					{column.items.map((item) => (
						<li>
							<a href={item.href} class="text-base text-ink2 hover:text-ink">{item.label}</a>
						</li>
					))}
				</ul>
			</nav>
		))}
	</div>
	<div class="wrap flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-line py-6 text-base text-ink3">
		<span>© 2026 Oribos · Apache-2.0</span>
		<span aria-hidden="true">·</span>
		<a href="/privacy-policy/" class="hover:text-ink">Privacy</a>
		<span aria-hidden="true">·</span>
		<a href="/terms-of-service/" class="hover:text-ink">Terms</a>
	</div>
</footer>
