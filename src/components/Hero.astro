---
// The home hero (SPEC §3.1): H1 → sub → the chip CTA → the GitHub text link → the product window
// below it — window dots + the `agent.ts` file tab + the `trace` badge + the code card's copy
// button in the bar, the code on the left, the same run's trace on the right. No kicker, no
// release-status control of its own (the header pill states the version), and no session title in
// the window bar. Narrow screens stack the two panes, each keeping its own horizontal scroll.
import { Code } from 'astro:components';
import { codeThemes } from '../lib/shiki-css.ts';
import { LINKS } from '../lib/links.ts';
import AgentPromptCta from './AgentPromptCta.astro';
import Check from './icons/Check.astro';
import Copy from './icons/Copy.astro';
import TraceWaterfall, { type TraceRow } from './TraceWaterfall.astro';

export interface Props {
	h1: string;
	sub: string;
	file: string;
	code: string;
	trace: { meta: string; rows: readonly TraceRow[]; summary: string };
}

const { h1, sub, file, code, trace } = Astro.props;
const shikiThemes = codeThemes;
---
<section class="py-24" data-hero>
	<div class="mx-auto flex max-w-3xl flex-col items-center text-center">
		<h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">{h1}</h1>
		<p class="mt-5 max-w-2xl text-lg text-ink2">{sub}</p>
		<div class="mt-8 flex flex-col items-center gap-3">
			<AgentPromptCta />
			<a href={LINKS.github} class="font-semibold text-acc hover:underline">GitHub</a>
		</div>
	</div>

	<div class="wrap mt-12 box bg-bg2 overflow-hidden" data-window>
		<div class="flex items-center gap-3 border-b border-line px-4 py-2.5" data-window-bar>
			<span class="flex gap-1.5" aria-hidden="true">
				<i class="size-2.5 rounded-full bg-ink3"></i>
				<i class="size-2.5 rounded-full bg-ink3"></i>
				<i class="size-2.5 rounded-full bg-ink3"></i>
			</span>
			<span class="font-mono text-xs text-ink2" data-file-tab>{file}</span>
			<span class="ml-auto box px-2.5 py-0.5 font-mono text-xs text-ink3" data-trace-badge>
				trace
			</span>
			<button type="button" data-copy-hero-code aria-label={`Copy ${file}`} class="p-1.5 text-ink3 hover:text-ink">
				<Copy data-copy-icon />
				<Check data-copied-icon hidden />
			</button>
		</div>
		<div class="grid md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
			<div class="overflow-x-auto border-b border-line p-4 md:border-r md:border-b-0" data-hero-code>
				<Code code={code} lang="ts" themes={shikiThemes} />
			</div>
			<div class="overflow-x-auto p-4">
				<TraceWaterfall meta={trace.meta} rows={trace.rows} summary={trace.summary} />
			</div>
		</div>
	</div>
</section>

<script>
	import { wireCopyButton } from '../lib/clipboard.ts';

	const pane = document.querySelector<HTMLElement>('[data-hero-code]');
	const button = document.querySelector<HTMLButtonElement>('[data-copy-hero-code]');
	const copyIcon = button?.querySelector<SVGElement>('[data-copy-icon]');
	const copiedIcon = button?.querySelector<SVGElement>('[data-copied-icon]');
	if (pane && button && copyIcon && copiedIcon) {
		const label = button.getAttribute('aria-label') ?? '';
		wireCopyButton(button, () => pane, {
			onCopied: () => {
				copyIcon.toggleAttribute('hidden', true);
				copiedIcon.toggleAttribute('hidden', false);
				button.setAttribute('aria-label', 'Copied');
			},
			onReset: () => {
				copiedIcon.toggleAttribute('hidden', true);
				copyIcon.toggleAttribute('hidden', false);
				button.setAttribute('aria-label', label);
			},
		});
	}
</script>
