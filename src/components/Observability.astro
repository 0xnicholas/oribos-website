---
// The observability band (SPEC §3.3): kicker → H2 claim → lead, then the §7.4 `app.ts` code card —
// one file with its copy button, spanning the band. No mock image, and no claim about exports:
// the band says what is traced and what stays zero-overhead, nothing more.
import CodeTabs from './CodeTabs.astro';

export interface Props {
	kicker: string;
	claim: string;
	lead: string;
	codeClaim: string;
	file: string;
	code: string;
}

const { kicker, claim, lead, codeClaim, file, code } = Astro.props;
---
<section id="observability" data-observability class="scroll-mt-20 border-t border-line py-24">
	<div class="wrap">
		<p class="text-base font-semibold tracking-wide text-acc">{kicker}</p>
		<h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink">{claim}</h2>
		<p class="mt-4 max-w-3xl text-ink2">{lead}</p>
		<h3 class="mt-10 text-lg font-semibold tracking-tight text-ink">{codeClaim}</h3>
		<div class="mt-4">
			<CodeTabs id="observability-app" files={[{ file, code }]} />
		</div>
	</div>
</section>
