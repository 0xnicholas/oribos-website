---
// The home use-case cards (SPEC-revamp §3.5): the intro, then three cards — the host-interface
// mock leads the card face, and the copy retreats under it to a title link that stretches over
// the whole card (`after:inset-0`) plus its one verbatim claim. The mocks reuse the hero window's
// component language and name no product, no logo and no person. No script: the section works
// without JS.
import { mockComponents } from './mocks/index.ts';

export interface UseCaseCard {
	title: string;
	claim: string;
	route: string;
	mock: 'chat' | 'thread' | 'console';
}

export interface Props {
	heading: string;
	sub: string;
	cards: readonly UseCaseCard[];
}

const { heading, sub, cards } = Astro.props;
---
<section id="use-cases" data-use-cases class="scroll-mt-20 border-t border-line py-24">
	<div class="wrap">
		<h2 class="mx-auto max-w-3xl text-center text-3xl font-semibold tracking-tight text-ink">{heading}</h2>
		<p class="mx-auto mt-4 max-w-2xl text-center text-ink3">{sub}</p>
		<ul class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
			{
				cards.map((card) => {
					const Mock = mockComponents[card.mock];
					return (
						<li
							data-use-case-card
							data-mock={card.mock}
							class="group relative flex flex-col overflow-hidden box transition-colors hover:border-acc"
						>
							<div class="p-4 pb-0">
								<Mock />
							</div>
							<div class="flex flex-1 flex-col gap-2 p-5" data-card-copy>
								<h3 class="text-lg font-semibold tracking-tight">
									<a
										href={card.route}
										data-card-link
										class="text-ink after:absolute after:inset-0 after:content-[''] group-hover:text-acc hover:text-acc"
									>
										{card.title}
									</a>
								</h3>
								<p class="text-base text-ink2">{card.claim}</p>
							</div>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>
