---
// The home page (SPEC-revamp §3, the nine-zone order): hero → the architecture facts band →
// feature tabs ×5 → the observability trio → the use-case cards → the resources cards → the
// global FAQ ×9 → the shared final CTA. The feature snippets pass through `fillVersion`, so the
// MCP card's `version` field is the one version constant (SPEC-revamp §4.6).
import { getCollection, getEntry } from 'astro:content';
import FaqList from '../components/FaqList.astro';
import FactsBand from '../components/FactsBand.astro';
import FeatureTabs from '../components/FeatureTabs.astro';
import FinalCta from '../components/FinalCta.astro';
import Hero from '../components/Hero.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Observability from '../components/Observability.astro';
import ResourcesStrip from '../components/ResourcesStrip.astro';
import UseCaseCards from '../components/UseCaseCards.astro';
import { fillVersion } from '../lib/version.ts';

const hero = await getEntry('hero', 'home');
const snippet = await getEntry('snippets', 'agent');
const appSnippet = await getEntry('snippets', 'app');
const trace = await getEntry('traces', 'hero');
const finalCta = await getEntry('finalCta', 'default');
const observability = await getEntry('observability', 'home');
const facts = (await getCollection('facts')).sort((a, b) => a.data.order - b.data.order);
const useCaseIntro = await getEntry('useCaseIntro', 'default');
const resources = await getEntry('resources', 'default');
const features = (await getCollection('features')).sort((a, b) => a.data.order - b.data.order);
const useCases = (await getCollection('useCases')).sort((a, b) => a.data.order - b.data.order);
const faq = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
if (
	!hero ||
	!snippet ||
	!appSnippet ||
	!trace ||
	!finalCta ||
	!observability ||
	!useCaseIntro ||
	!resources ||
	facts.length !== 4 ||
	features.length !== 5 ||
	useCases.length !== 3 ||
	faq.length !== 9
) {
	throw new Error('the home page needs its content entries (SPEC-revamp §3.1–§3.8)');
}
---
<MarketingLayout
	title="Oribos — ultralight TypeScript AI agent framework"
	description="Oribos is an ultralight TypeScript agent framework: compose only what you use, run anywhere, with zero runtime dependencies."
>
	<Hero
		h1={hero.data.h1}
		sub={hero.data.sub}
		file={snippet.data.file}
		code={snippet.data.code}
		trace={trace.data}
	/>
	<FactsBand facts={facts.map((entry) => entry.data)} />
	<FeatureTabs
		features={features.map((entry) => ({
			id: entry.id,
			...entry.data,
			files: entry.data.files.map((file) => ({ ...file, code: fillVersion(file.code) })),
		}))}
	/>
	<Observability
		kicker={observability.data.kicker}
		claim={observability.data.claim}
		lead={observability.data.lead}
		codeClaim={observability.data.codeClaim}
		file={appSnippet.data.file}
		code={appSnippet.data.code}
		trace={trace.data}
	/>
	<UseCaseCards
		heading={useCaseIntro.data.heading}
		sub={useCaseIntro.data.sub}
		cards={useCases.map((entry) => entry.data)}
	/>
	<ResourcesStrip kicker={resources.data.kicker} links={resources.data.links} />
	<FaqList items={faq.map((entry) => entry.data)} />
	<FinalCta heading={finalCta.data.heading} sub={finalCta.data.sub} />
</MarketingLayout>
